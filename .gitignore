# Raw / derived person-level data must never be committed. Bracket patterns make the extension match
# case-insensitive even when core.ignorecase=false (e.g. Linux clones): *.sav, *.SAV, *.Sav, ... are all ignored.
*.[sS][aA][vV]
*.[dD][tT][aA]
*.[sS][aA][sS]7[bB][dD][aA][tT]
*.[xX][lL][sS][xX]
*.[xX][lL][sS]
*.[pP][aA][rR][qQ][uU][eE][tT]
*.[pP][oO][rR]
*.[zZ][iI][pP]
*.[cC][sS][vV].[gG][zZ]
*.[fF][eE][aA][tT][hH][eE][rR]
*.[rR][dD][sS]
*.[rR][dD][aA][tT][aA]
*.[jJ][oO][bB][lL][iI][bB]
*.[pP][kK][lL]
data/
rtw_cache/
cache/
# environment
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.venv/
# run outputs (regenerate locally; caches hold row-level predictions)
rtw_outputs/
rtw_work/
joblib_tmp/
