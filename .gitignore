# Raw / derived person-level data must never be committed (patterns repeated in upper case because
# git matching is case-sensitive when core.ignorecase=false, e.g. on Linux clones)
*.sav
*.SAV
*.Sav
*.dta
*.DTA
*.sas7bdat
*.SAS7BDAT
*.xlsx
*.XLSX
*.xls
*.XLS
*.csv.gz
*.parquet
*.PARQUET
*.por
*.POR
*.zip
*.ZIP
data/
rtw_cache/
cache/
*.joblib
*.pkl
# environment
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.venv/
# run outputs (regenerate locally; caches hold row-level predictions)
rtw_outputs/
rtw_work/
